{
  "version": 1,
  "sources": [
    "clear.c"
  ],
  "warnings": "error",
  "tests": [
    {
      "name": "clear bit 1 of 7",
      "run": {
        "stdin": "7\n1\n"
      },
      "expect": {
        "stdout": "Flags: Bit: 5\n",
        "exit": 0
      },
      "hint": "Which bits survive `flags & (1 << n)`? Only bit n itself."
    },
    {
      "name": "clearing a bit that is already off changes nothing",
      "run": {
        "stdin": "5\n1\n"
      },
      "expect": {
        "stdout": "Flags: Bit: 5\n",
        "exit": 0
      }
    },
    {
      "name": "clear bit 0 of 1",
      "run": {
        "stdin": "1\n0\n"
      },
      "expect": {
        "stdout": "Flags: Bit: 0\n",
        "exit": 0
      }
    },
    {
      "name": "clear bit 7 of 255",
      "run": {
        "stdin": "255\n7\n"
      },
      "expect": {
        "stdout": "Flags: Bit: 127\n",
        "exit": 0
      }
    },
    {
      "name": "clear bit 3 of 0",
      "run": {
        "stdin": "0\n3\n"
      },
      "expect": {
        "stdout": "Flags: Bit: 0\n",
        "exit": 0
      }
    },
    {
      "name": "clear bit 2 of 14",
      "run": {
        "stdin": "14\n2\n"
      },
      "expect": {
        "stdout": "Flags: Bit: 10\n",
        "exit": 0
      }
    }
  ]
}
