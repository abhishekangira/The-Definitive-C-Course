{
  "version": 1,
  "sources": [
    "steps.c"
  ],
  "warnings": "error",
  "tests": [
    {
      "name": "height 1",
      "run": {
        "stdin": "1\n"
      },
      "expect": {
        "stdout": "Height: #\n",
        "exit": 0
      }
    },
    {
      "name": "height 3",
      "run": {
        "stdin": "3\n"
      },
      "expect": {
        "stdout": "Height: ###\n##\n#\n",
        "exit": 0
      }
    },
    {
      "name": "rejects 6",
      "run": {
        "stdin": "6\n2\n"
      },
      "expect": {
        "stdout": "Height: Height: ##\n#\n",
        "exit": 0
      }
    }
  ]
}
