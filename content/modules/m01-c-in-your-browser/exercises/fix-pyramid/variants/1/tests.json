{
  "version": 1,
  "sources": [
    "countdown.c"
  ],
  "warnings": "error",
  "tests": [
    {
      "name": "n = 3 counts 3, 2, 1",
      "run": {
        "stdin": "3\n"
      },
      "expect": {
        "stdout": "n: 3\n2\n1\ndone\n",
        "exit": 0
      }
    },
    {
      "name": "n = 1 prints 1",
      "run": {
        "stdin": "1\n"
      },
      "expect": {
        "stdout": "n: 1\ndone\n",
        "exit": 0
      }
    }
  ]
}
