{
  "name": "the-definitive-c-course",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A self-paced, interactive course that teaches C17 and low-level fundamentals to front-end engineers.",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "npm run toolchain:prepare && node tools/check/build.mjs --into public && vite",
    "build": "npm run toolchain:prepare && tsc --noEmit && vite build && node tools/check/build.mjs --into dist",
    "preview": "vite preview",
    "toolchain:prepare": "node tools/toolchain/prepare.mjs",
    "localsetup:debian": "bash tools/setup/debian.sh",
    "verify": "tsx tools/verify/cli.ts",
    "verify:exercises": "tsx tools/exercises/cli.ts",
    "exercises:expect": "tsx tools/exercises/expect-cli.ts",
    "trace": "tsx tools/trace/cli.ts",
    "lint:content": "tsx tools/content-lint/cli.ts",
    "anim:check": "node tools/anim/check.mjs",
    "anim:render": "node tools/anim/render.mjs",
    "videos:check": "tsx tools/videos/check.ts",
    "check:build": "node tools/check/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dod": "tsx tools/dod/cli.ts",
    "e2e": "playwright test",
    "e2e:stress": "node e2e/stress.mjs"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@mdx-js/react": "3.1.1",
    "@yowasp/clang": "22.0.0-git20542-10",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.56.1",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-mdx-frontmatter": "6.0.0",
    "remark-parse": "11.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
